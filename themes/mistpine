# mistpine: the mistpine color scheme for Ghostty 1.3+.
# https://github.com/mistpine/mistpine.ghostty · MIT License
#
# Save this file as ~/.config/ghostty/themes/mistpine, then add
# `theme = mistpine` to your Ghostty config.
#
# Generated by scripts/generate.ts from the mistpine spec
# (https://github.com/mistpine/mistpine/blob/main/palette/mistpine.json).
# Do not edit by hand.

# Canvas and text: bg1 and fg3.
background = #0b1f27
foreground = #c4c9d0

# Block cursor: fg3, with the character under it in bg1.
cursor-color = #c4c9d0
cursor-text = #0b1f27

# Selection: bg4 under the brightest white.
selection-background = #26414a
selection-foreground = #d0d1d6

# Search (Ghostty 1.3+): matches on yellow mixed 35% over bg1, as the
# editor's search highlight; the selected match in orange.
search-background = #464b3c
search-foreground = #c4c9d0
search-selected-background = #c98b56
search-selected-foreground = #0b1f27

# Splits: dividers are borders (bg4); unfocused splits recede toward bg0.
split-divider-color = #26414a
unfocused-split-fill = #071921

# ANSI 0-7, then the brights 8-15. 0 is bg2, not the background, so
# black-on-default output stays visible; 8 is the dim gray and 15 the
# brightest white. 16-255 keep Ghostty's defaults (palette-generate = true
# derives them from these instead).
palette = 0=#0f272e
palette = 1=#be7356
palette = 2=#8a9a5b
palette = 3=#c2a55b
palette = 4=#6f8fa8
palette = 5=#9a88a8
palette = 6=#5f9a96
palette = 7=#a7b0bb

palette = 8=#546b76
palette = 9=#d08a6e
palette = 10=#a9b97a
palette = 11=#dcc27e
palette = 12=#93afc4
palette = 13=#b8a8c6
palette = 14=#86bcb6
palette = 15=#d0d1d6
